# REI Adapt-1 (required for train/frozen modes)
ADAPT1_BASE_URL=https://rei-neuroadapt-api.reilabs.org
ADAPT1_API_KEY=
ADAPT1_DOMAIN_ID=factorio-strategy-v3

# Local FLE code-synthesis model (no third-party model API key required).
ADAPT1_FLE_MODEL=ollama-qwen2.5-coder:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Optional hosted alternatives:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPEN_ROUTER_API_KEY=

# Local Factorio Learning Environment
FLE_DB_TYPE=sqlite
SQLITE_DB_FILE=.fle/data.db
PORT_OFFSET=0

# Research harness
ADAPT1_FLE_MODE=baseline
ADAPT1_FLE_ENV_ID=iron_ore_throughput
ADAPT1_FLE_TRAJECTORY_LENGTH=64
ADAPT1_FLE_MAX_WORKERS=1
ADAPT1_FLE_MEMORY_ENABLED=true
ADAPT1_FLE_LEDGER_ROOT=.fle/adapt1/runs
ADAPT1_FLE_TIMEOUT_SECONDS=120
